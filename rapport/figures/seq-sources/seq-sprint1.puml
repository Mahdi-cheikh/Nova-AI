@startuml seq-sprint1
title Sprint 1 — Réservation WhatsApp et authentification

skinparam shadowing false
skinparam roundcorner 6
skinparam sequence {
  ArrowColor #4F46E5
  LifeLineBorderColor #6366F1
  ParticipantBorderColor #4F46E5
  ParticipantBackgroundColor #EEF2FF
  ActorBorderColor #4F46E5
  ActorBackgroundColor #C7D2FE
}

actor Patient
participant "WhatsApp\nMeta Cloud API" as Meta
participant "whatsapp-webhook\n(Edge Function)" as WH
database "Supabase\nPostgres + RLS" as DB
participant "classify-message\n(Claude Haiku)" as AI

== Premier contact ==
Patient -> Meta : Message texte
Meta -> WH : POST webhook (changes[])
WH -> DB : INSERT messages (in)
WH -> AI : POST { phone, text, business_id }
AI -> DB : SELECT business, draft, services
AI -> AI : parsing intent + champs
AI -> DB : UPSERT booking_drafts (state)
AI -> Meta : SEND reply (question suivante)
Meta -> Patient : Question (langue détectée)

== Conversation multi-tour ==
Patient -> Meta : Réponse (date, heure, service)
Meta -> WH : POST webhook
WH -> AI : forward
AI -> DB : UPDATE booking_drafts
AI -> Meta : Récapitulatif + "OUI / NON ?"
Meta -> Patient : Récapitulatif

== Confirmation ==
Patient -> Meta : "Oui"
Meta -> WH : POST
WH -> AI : forward
AI -> DB : vérif horaires + conflits
AI -> DB : INSERT appointments (status=confirmed)
note right : trigger auto-génère checkin_token
AI -> DB : DELETE booking_drafts
AI -> Meta : Confirmation + lien check-in
Meta -> Patient : "Confirmé ! https://.../check.html?a=..."

@enduml
