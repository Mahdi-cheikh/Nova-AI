@startuml
skinparam defaultFontName Sans-Serif
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #E0E7FF
skinparam ParticipantBorderColor #6366f1
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #6366f1
skinparam ArrowColor #475569

actor "Admin" as A
participant "Page d'accueil" as W
participant "Supabase Auth" as Auth
database "Postgres + RLS" as DB

A -> W : saisit son e-mail
W -> Auth : signInWithOtp(email)
Auth -> A : envoi e-mail avec lien magique
A -> W : clique sur le lien magique
W -> Auth : verifyOtp(token)
Auth --> W : JWT (session active)
W -> DB : SELECT businesses WHERE owner_user_id=auth.uid()
DB --> W : ligne entreprise (ou vide)

alt premiere connexion
    W -> A : formulaire "choisir type entreprise"
    A -> W : selectionne (clinique, labo, garage...)
    W -> DB : INSERT businesses(owner_user_id, type, ...)
    DB --> W : ligne creee
end

W --> A : tableau de bord ouvert

@enduml
