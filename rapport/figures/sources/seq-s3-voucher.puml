@startuml
skinparam defaultFontName Sans-Serif
skinparam defaultFontSize 12
skinparam ParticipantBackgroundColor #E0E7FF
skinparam ParticipantBorderColor #6366f1
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #6366f1
skinparam ArrowColor #475569

participant "pg_cron\n(07h00 quotidien)" as Cron
participant "birthday-batch\n(Edge Function)" as BB
database "Postgres + RLS" as DB
participant "Meta WhatsApp" as Meta
actor "Patient" as P

Cron -> BB : trigger 07h00
BB -> DB : SELECT clients\nWHERE birthday = today()
DB --> BB : liste anniversaires

loop pour chaque client
    BB -> BB : genere code voucher unique
    BB -> DB : INSERT vouchers\n(client_id, code, expires_at)
    BB -> DB : SELECT language_pref du client
    DB --> BB : langue
    BB -> Meta : sendTextMessage(personnalise + voucher)
    Meta --> P : message anniversaire WhatsApp
end

... le patient utilise plus tard ...

P -> Meta : envoie "NOVA-XYZ-2026"
Meta -> WH : POST webhook
WH -> DB : SELECT vouchers WHERE code=...
DB --> WH : voucher valide
WH -> DB : UPDATE vouchers SET redeemed_at=now()
WH -> Meta : sendTextMessage("Voucher applique!")

@enduml
