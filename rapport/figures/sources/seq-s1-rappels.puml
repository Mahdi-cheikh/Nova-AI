@startuml
skinparam defaultFontName Sans-Serif
skinparam defaultFontSize 12
skinparam ParticipantBackgroundColor #E0E7FF
skinparam ParticipantBorderColor #6366f1
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #6366f1
skinparam ArrowColor #475569

participant "pg_cron\n(scheduler)" as Cron
participant "send-reminders\n(Edge Function)" as SR
database "Postgres + RLS" as DB
participant "Meta WhatsApp" as Meta
actor "Patient" as P
participant "whatsapp-webhook" as WH

Cron -> SR : trigger toutes les 10 min
SR -> DB : SELECT appointments WHERE\nscheduled_at BETWEEN now()+23h AND now()+24h\nAND reminder_sent_24h = false
DB --> SR : liste de RDV cibles

loop pour chaque RDV
    SR -> Meta : sendInteractiveButtons(phone, "Confirmer", "Annuler")
    Meta --> P : message rappel avec 2 boutons
    SR -> DB : UPDATE appointments SET reminder_sent_24h=true
end

... 23 heures plus tard ...

P -> Meta : clique sur "Confirmer" (ou "Annuler")
Meta -> WH : POST webhook (button reply)
WH -> DB : UPDATE appointments SET status='confirmed' (ou 'cancelled')
WH -> Meta : sendTextMessage("Merci, RDV confirme!")
Meta --> P : confirmation finale

@enduml
