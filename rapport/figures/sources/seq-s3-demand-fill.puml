@startuml
skinparam defaultFontName Sans-Serif
skinparam defaultFontSize 12
skinparam ParticipantBackgroundColor #E0E7FF
skinparam ParticipantBorderColor #6366f1
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #6366f1
skinparam ArrowColor #475569

participant "pg_cron\n(06h00 quotidien)" as Cron
participant "demand-fill-runner\n(Edge Function)" as DF
database "Postgres + RLS" as DB
actor "Admin" as A
participant "Dashboard" as DASH
participant "Meta WhatsApp" as Meta
actor "Clients\nrecurrents" as Clients

Cron -> DF : trigger 06h00
DF -> DB : SELECT slots libres (J et J+1)
DB --> DF : creneaux vides
DF -> DB : SELECT clients recurrents\n(derniere visite < 3 mois)
DB --> DF : liste cibles
DF -> DB : INSERT demand_fill_campaigns\n(status='draft', targeted_clients)
DF -> DB : INSERT notifications\n(type='demand_fill', user=admin)
DB -> DASH : push Realtime "nouvelle notif"
DASH --> A : notification (au lever)

A -> DASH : ouvre la campagne brouillon
A -> DASH : approuve (ou modifie)
DASH -> DB : UPDATE campaign SET status='approved'
DASH -> DF : invoke send-batch

loop pour chaque client cible (par lots de 20)
    DF -> Meta : sendTextMessage("Creneau libre demain a 14h, vous en voulez?")
    Meta --> Clients : message WhatsApp
end

DF -> DB : UPDATE campaign SET sent_at=now()

@enduml
