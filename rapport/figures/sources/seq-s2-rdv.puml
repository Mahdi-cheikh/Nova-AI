@startuml
skinparam defaultFontName Sans-Serif
skinparam defaultFontSize 12
skinparam ParticipantBackgroundColor #E0E7FF
skinparam ParticipantBorderColor #6366f1
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #6366f1
skinparam ArrowColor #475569

actor "Admin" as A
participant "Dashboard\n(Calendrier)" as DASH
participant "PostgREST\n(API REST)" as API
database "Postgres + RLS" as DB
participant "Realtime\n(WebSocket)" as RT
participant "Meta WhatsApp" as Meta
actor "Patient" as P

A -> DASH : ouvre la vue calendrier
DASH -> API : GET /appointments?business_id=X
API -> DB : SELECT * FROM appointments
DB --> API : liste filtree par RLS
API --> DASH : RDV du business

A -> DASH : clique sur un creneau libre
DASH -> A : affiche formulaire modal\n(client, service, heure)
A -> DASH : saisit les details
DASH -> API : POST /appointments { ... }
API -> DB : INSERT appointments
DB -> RT : trigger postgres_changes
RT --> DASH : push live (autres onglets)
DASH -> Meta : sendTextMessage("Nouveau RDV: ...")
Meta --> P : notification WhatsApp
DASH --> A : RDV cree, calendrier rafraichi

@enduml
