flowchart TB
    classDef user fill:#f1f5f9,stroke:#475569,stroke-width:2px,color:#0f172a,font-weight:bold
    classDef fe   fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef be   fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d
    classDef db   fill:#bbf7d0,stroke:#15803d,stroke-width:2px,color:#14532d
    classDef ext  fill:#fed7aa,stroke:#ea580c,stroke-width:2px,color:#7c2d12

    USERS["👤 ADMINISTRATEUR &nbsp;·&nbsp; 🧑 PATIENT"]:::user

    subgraph FE ["🖥️ COUCHE PRÉSENTATION (Frontends)"]
        direction TB
        DASH["Tableau de bord administrateur<br/>SPA · JS vanille · Vercel"]:::fe
        PWA["PWA patient<br/>service worker · hors ligne · OTP"]:::fe
    end

    subgraph BE ["⚙️ COUCHE MÉTIER + DONNÉES (Backend Supabase)"]
        direction TB
        API["PostgREST · Auth (magic link) · Realtime (WS)"]:::be
        EDGE["Edge Functions (Deno)<br/>webhook WhatsApp · OCR · OTP · rappels"]:::be
        DB[("PostgreSQL + Row-Level Security<br/>Storage S3 · pg_cron")]:::db
    end

    subgraph EXT ["🌐 SERVICES EXTERNES (API tierces)"]
        direction TB
        META["Meta WhatsApp Cloud API"]:::ext
        CLAUDE["Anthropic Claude (LLM)<br/>classification + OCR vision"]:::ext
        OAI["OpenAI Whisper (STT)<br/>transcription audio"]:::ext
        EL["ElevenLabs (TTS)<br/>voix clonée"]:::ext
    end

    USERS ==>|navigateur HTTPS| FE
    FE   ==>|REST + WebSocket| BE
    BE   ==>|API tierces| EXT

    style FE  fill:#eff6ff,stroke:#3b82f6,stroke-width:2.5px
    style BE  fill:#f0fdf4,stroke:#22c55e,stroke-width:2.5px
    style EXT fill:#fff7ed,stroke:#f97316,stroke-width:2.5px
